<configuration>

    <!-- Define the log file location -->
    <property name="REDIRECTOR_LOG_FILE" value="${REDIRECTOR_LOG_FILE:-files/logs/application.json}"/>


    <!-- Console appender for logging to the console (STDOUT) -->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>time</fieldName>
                </timestamp>
                <provider class="de.gematik.zts.redirector.logging.CustomLogLevelJsonProvider" />
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <message>
                    <fieldName>message</fieldName>
                </message>
                <logstashMarkers />
                <!-- Add Stacktrace Provider -->
                <stackTrace>
                    <fieldName>stacktrace</fieldName>
                </stackTrace>
            </providers>
        </encoder>

        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <OnMatch>DENY</OnMatch>
            <OnMismatch>ACCEPT</OnMismatch>
        </filter>
    </appender>

    <!-- Console appender for logging to the console (STDERR) -->
    <appender name="console-error" class="ch.qos.logback.core.ConsoleAppender">
        <!-- target stderr -->
        <target>System.err</target>
        <!-- Configure JSON Logging -->
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>

                <timestamp>
                    <fieldName>time</fieldName>
                </timestamp>
                <provider class="de.gematik.zts.redirector.logging.CustomLogLevelJsonProvider" />
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <message>
                    <fieldName>message</fieldName>
                </message>
                <logstashMarkers />
                <!-- Stacktrace-Provider hinzufügen -->
                <stackTrace>
                    <fieldName>stacktrace</fieldName>
                </stackTrace>
            </providers>
        </encoder>
        <!-- logs everything with level = ERROR -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <OnMismatch>DENY</OnMismatch>
            <OnMatch>ACCEPT</OnMatch>
        </filter>
    </appender>

    <root level="info">
        <appender-ref ref="console"/>
        <appender-ref ref="console-error"/>
    </root>
</configuration>
